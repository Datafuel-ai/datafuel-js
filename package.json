{
  "name": "datafuel",
  "version": "0.1.0",
  "description": "TypeScript client for the DataFuel scraping API",
  "license": "MIT",
  "homepage": "https://datafuel.ai",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude '**/live.test.ts'",
    "test:live": "vitest run test/live.test.ts --testTimeout=300000",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "datafuel",
    "scraping",
    "crawler",
    "web-scraping",
    "markdown",
    "llm"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Datafuel-ai/datafuel-js.git"
  },
  "bugs": {
    "url": "https://github.com/Datafuel-ai/datafuel-js/issues"
  }
}
