{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist",
    // tsup's declaration step still passes the deprecated `baseUrl`; TypeScript
    // 6 errors on it unless this is set. Drop it when tsup stops doing that.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "test", "examples", "*.ts"]
}
